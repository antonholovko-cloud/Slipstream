<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the unpacked app folder (dist/win-unpacked) before
     the installers are built from it, so the Slipstream.exe they install is signed too. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Slipstream.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
